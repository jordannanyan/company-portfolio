PORT=4200
DB_HOST=127.0.0.1
DB_USER=bantutugas
DB_PASSWORD=change-me
DB_NAME=bantutugas

# Admin page (https://bantutugas.site/admin/). Leave empty to disable it.
ADMIN_PASSWORD=
# Optional: random string to sign login cookies. Defaults to one derived from ADMIN_PASSWORD,
# so changing the password logs everyone out.
SESSION_SECRET=

# Email notification for every new lead. For Gmail, SMTP_PASS is an App Password
# (myaccount.google.com/apppasswords, needs 2-Step Verification), not the normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=jordan10nanyan@gmail.com
ADMIN_URL=https://bantutugas.site/admin/
